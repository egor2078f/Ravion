// Protection System for RAVION SCRIPTS
(function() {
    'use strict';
    
    // Protection configuration
    const PROTECTION_CONFIG = {
        debugMode: false,
        blockDevTools: true,
        blockRightClick: true,
        blockCopy: false, // Allow copy for scripts
        blockF12: true,
        blockCtrlKeys: true,
        userAgentCheck: true
    };

    // Developer credentials (change these!)
    const DEVELOPER_CREDENTIALS = {
        username: "Lurk2104",
        password: "LURK-9DIA-QOVF-94JE",
        token: "ravion_secure_token_2025"
    };

    // Protection functions
    class SiteProtection {
        constructor() {
            this.isDeveloper = false;
            this.init();
        }

        init() {
            this.checkUserAgent();
            this.setupEventListeners();
            this.setupDeveloperAuth();
            this.log('Protection system initialized');
        }

        // Check for bots and suspicious user agents
        checkUserAgent() {
            if (!PROTECTION_CONFIG.userAgentCheck) return;

            const userAgent = navigator.userAgent.toLowerCase();
            const blockedPatterns = [
                'bot', 'crawler', 'spider', 'scraper',
                'curl', 'wget', 'python', 'java',
                'phantom', 'headless', 'selenium'
            ];

            const isBlocked = blockedPatterns.some(pattern => 
                userAgent.includes(pattern)
            );

            if (isBlocked) {
                this.blockAccess('Suspicious user agent detected');
            }
        }

        // Setup event listeners for protection
        setupEventListeners() {
            // Block right-click
            if (PROTECTION_CONFIG.blockRightClick) {
                document.addEventListener('contextmenu', (e) => {
                    e.preventDefault();
                    this.log('Right-click blocked');
                    return false;
                });
            }

            // Block F12 and developer tools
            if (PROTECTION_CONFIG.blockF12 || PROTECTION_CONFIG.blockDevTools) {
                document.addEventListener('keydown', (e) => {
                    // Block F12
                    if (PROTECTION_CONFIG.blockF12 && e.key === 'F12') {
                        e.preventDefault();
                        this.log('F12 blocked');
                        return false;
                    }

                    // Block Ctrl+Shift+I, Ctrl+Shift+J, Ctrl+Shift+C
                    if (PROTECTION_CONFIG.blockDevTools && e.ctrlKey && e.shiftKey) {
                        if (['I', 'J', 'C'].includes(e.key)) {
                            e.preventDefault();
                            this.log('Developer tools shortcut blocked');
                            return false;
                        }
                    }

                    // Block Ctrl+U (view source)
                    if (PROTECTION_CONFIG.blockCtrlKeys && e.ctrlKey && e.key === 'u') {
                        e.preventDefault();
                        this.log('View source blocked');
                        return false;
                    }
                });
            }

            // Detect developer tools opening
            if (PROTECTION_CONFIG.blockDevTools) {
                this.detectDevTools();
            }
        }

        // Detect developer tools
        detectDevTools() {
            const element = new Image();
            Object.defineProperty(element, 'id', {
                get: function() {
                    throw new Error('Dev tools detected');
                }
            });

            setInterval(() => {
                try {
                    console.log(element);
                    console.clear();
                } catch (error) {
                    this.blockAccess('Developer tools detected');
                }
            }, 1000);
        }

        // Developer authentication system
        setupDeveloperAuth() {
            // Check if developer is already logged in
            const devToken = localStorage.getItem('dev_token');
            if (devToken === DEVELOPER_CREDENTIALS.token) {
                this.isDeveloper = true;
                this.log('Developer authenticated');
                this.showDeveloperPanel();
            }
        }

        // Show developer login modal
        showLoginModal() {
            const modalHTML = `
                <div id="devLoginModal" style="
                    position: fixed;
                    top: 0;
                    left: 0;
                    width: 100%;
                    height: 100%;
                    background: rgba(0,0,0,0.8);
                    display: flex;
                    justify-content: center;
                    align-items: center;
                    z-index: 10000;
                ">
                    <div style="
                        background: #111;
                        padding: 2rem;
                        border-radius: 12px;
                        border: 1px solid #333;
                        width: 90%;
                        max-width: 400px;
                    ">
                        <h3 style="color: #fff; margin-bottom: 1rem; text-align: center;">
                            Developer Login
                        </h3>
                        <form id="devLoginForm">
                            <div style="margin-bottom: 1rem;">
                                <input type="text" id="devUsername" placeholder="Username" 
                                    style="width: 100%; padding: 12px; background: #1a1a1a; border: 1px solid #333; border-radius: 6px; color: #fff; margin-bottom: 1rem;">
                                <input type="password" id="devPassword" placeholder="Password" 
                                    style="width: 100%; padding: 12px; background: #1a1a1a; border: 1px solid #333; border-radius: 6px; color: #fff;">
                            </div>
                            <button type="submit" style="
                                width: 100%; padding: 12px; background: #ff6b00; 
                                border: none; border-radius: 6px; color: #fff; 
                                font-weight: bold; cursor: pointer;
                            ">Login</button>
                        </form>
                        <button onclick="protection.hideLoginModal()" style="
                            width: 100%; padding: 10px; background: transparent; 
                            border: 1px solid #333; border-radius: 6px; color: #888; 
                            margin-top: 1rem; cursor: pointer;
                        ">Cancel</button>
                    </div>
                </div>
            `;

            document.body.insertAdjacentHTML('beforeend', modalHTML);
            
            document.getElementById('devLoginForm').addEventListener('submit', (e) => {
                e.preventDefault();
                this.handleDeveloperLogin();
            });
        }

        // Handle developer login
        handleDeveloperLogin() {
            const username = document.getElementById('devUsername').value;
            const password = document.getElementById('devPassword').value;

            if (username === DEVELOPER_CREDENTIALS.username && 
                password === DEVELOPER_CREDENTIALS.password) {
                
                this.isDeveloper = true;
                localStorage.setItem('dev_token', DEVELOPER_CREDENTIALS.token);
                this.hideLoginModal();
                this.showDeveloperPanel();
                this.log('Developer login successful');
                
            } else {
                alert('Invalid credentials');
            }
        }

        // Hide login modal
        hideLoginModal() {
            const modal = document.getElementById('devLoginModal');
            if (modal) {
                modal.remove();
            }
        }

        // Show developer panel
        showDeveloperPanel() {
            // Add developer button to header
            const navActions = document.querySelector('.nav-actions');
            if (navActions && !document.getElementById('devPanelBtn')) {
                const devButton = document.createElement('button');
                devButton.id = 'devPanelBtn';
                devButton.innerHTML = '<i class="fas fa-code"></i>';
                devButton.style.background = 'none';
                devButton.style.border = 'none';
                devButton.style.color = '#ff6b00';
                devButton.style.fontSize = '1.2rem';
                devButton.style.cursor = 'pointer';
                devButton.style.padding = '0.5rem';
                devButton.style.borderRadius = '8px';
                devButton.title = 'Developer Panel';
                
                devButton.addEventListener('click', () => {
                    this.toggleDeveloperPanel();
                });

                navActions.insertBefore(devButton, navActions.firstChild);
            }

            // Add developer panel to footer
            if (!document.getElementById('devPanel')) {
                const devPanelHTML = `
                    <div id="devPanel" style="
                        margin-top: 2rem; padding: 1.5rem; background: #1a1a1a; 
                        border-radius: 10px; border: 1px solid #333; display: none;
                    ">
                        <h4 style="color: #ff6b00; margin-bottom: 1rem;">
                            <i class="fas fa-shield-alt"></i> Developer Panel
                        </h4>
                        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1rem; margin-bottom: 1rem;">
                            <div style="background: #111; padding: 1rem; border-radius: 6px; border: 1px solid #333;">
                                <div style="color: #888; font-size: 0.8rem;">Database Stats</div>
                                <div style="color: #fff; font-size: 1.2rem; font-weight: bold;" id="dbStats">Loading...</div>
                            </div>
                            <div style="background: #111; padding: 1rem; border-radius: 6px; border: 1px solid #333;">
                                <div style="color: #888; font-size: 0.8rem;">Protection Status</div>
                                <div style="color: #00ff00; font-size: 1.2rem; font-weight: bold;">ACTIVE</div>
                            </div>
                        </div>
                        <div style="display: flex; gap: 0.5rem; flex-wrap: wrap;">
                            <button onclick="protection.exportDatabase()" style="
                                padding: 8px 12px; background: #111; border: 1px solid #333; 
                                border-radius: 6px; color: #fff; cursor: pointer; font-size: 0.8rem;
                            "><i class="fas fa-download"></i> Export DB</button>
                            <button onclick="protection.clearDatabase()" style="
                                padding: 8px 12px; background: #111; border: 1px solid #333; 
                                border-radius: 6px; color: #ff4757; cursor: pointer; font-size: 0.8rem;
                            "><i class="fas fa-trash"></i> Clear DB</button>
                            <button onclick="protection.logout()" style="
                                padding: 8px 12px; background: #111; border: 1px solid #333; 
                                border-radius: 6px; color: #888; cursor: pointer; font-size: 0.8rem;
                            "><i class="fas fa-sign-out-alt"></i> Logout</button>
                        </div>
                    </div>
                `;

                const footerContent = document.querySelector('.footer-content');
                if (footerContent) {
                    footerContent.insertAdjacentHTML('beforeend', devPanelHTML);
                }
            }
        }

        // Toggle developer panel
        toggleDeveloperPanel() {
            const panel = document.getElementById('devPanel');
            if (panel) {
                panel.style.display = panel.style.display === 'none' ? 'block' : 'none';
                this.updateDatabaseStats();
            }
        }

        // Update database statistics
        updateDatabaseStats() {
            if (!this.isDeveloper) return;

            try {
                const dbData = JSON.parse(localStorage.getItem('ravion_database') || '{}');
                const totalViews = Object.values(dbData.views || {}).reduce((a, b) => a + b, 0);
                const totalScripts = Object.keys(dbData.views || {}).length;

                const statsElement = document.getElementById('dbStats');
                if (statsElement) {
                    statsElement.innerHTML = `${totalViews} views<br>${totalScripts} scripts`;
                }
            } catch (error) {
                console.error('Error updating DB stats:', error);
            }
        }

        // Export database
        exportDatabase() {
            if (!this.isDeveloper) return;

            try {
                const dbData = localStorage.getItem('ravion_database');
                const blob = new Blob([dbData], { type: 'application/json' });
                const url = URL.createObjectURL(blob);
                const a = document.createElement('a');
                a.href = url;
                a.download = `ravion_database_${Date.now()}.json`;
                document.body.appendChild(a);
                a.click();
                document.body.removeChild(a);
                URL.revokeObjectURL(url);
                
                this.log('Database exported');
            } catch (error) {
                console.error('Error exporting database:', error);
            }
        }

        // Clear database
        clearDatabase() {
            if (!this.isDeveloper) return;

            if (confirm('Are you sure you want to clear all database data? This cannot be undone!')) {
                localStorage.removeItem('ravion_database');
                this.log('Database cleared');
                this.updateDatabaseStats();
            }
        }

        // Developer logout
        logout() {
            this.isDeveloper = false;
            localStorage.removeItem('dev_token');
            
            const devPanel = document.getElementById('devPanel');
            const devButton = document.getElementById('devPanelBtn');
            
            if (devPanel) devPanel.remove();
            if (devButton) devButton.remove();
            
            this.log('Developer logged out');
        }

        // Block access to the site
        blockAccess(reason) {
            if (PROTECTION_CONFIG.debugMode) {
                this.log(`Access blocked: ${reason}`);
                return;
            }

            document.body.innerHTML = `
                <div style="
                    position: fixed;
                    top: 0;
                    left: 0;
                    width: 100%;
                    height: 100%;
                    background: #000;
                    color: #fff;
                    display: flex;
                    justify-content: center;
                    align-items: center;
                    font-family: Arial, sans-serif;
                    z-index: 99999;
                ">
                    <div style="text-align: center;">
                        <h1 style="color: #ff4757; margin-bottom: 1rem;">Access Denied</h1>
                        <p style="color: #888; margin-bottom: 2rem;">${reason}</p>
                        <p style="color: #555;">RAVION SCRIPTS Protection System</p>
                    </div>
                </div>
            `;

            throw new Error(`Access blocked: ${reason}`);
        }

        // Log messages (only in debug mode)
        log(message) {
            if (PROTECTION_CONFIG.debugMode) {
                console.log(`[RAVION Protection] ${message}`);
            }
        }
    }

    // Initialize protection system
    window.protection = new SiteProtection();

    // Add developer login trigger (Ctrl+Alt+D)
    document.addEventListener('keydown', (e) => {
        if (e.ctrlKey && e.altKey && e.key === 'd') {
            e.preventDefault();
            if (!window.protection.isDeveloper) {
                window.protection.showLoginModal();
            }
        }
    });

})();
